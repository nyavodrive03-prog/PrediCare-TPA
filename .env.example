# ===== Base de données PostgreSQL + pgvector =====
POSTGRES_DB=predicare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
DB_HOST=db
DB_PORT=5432
DB_NAME=predicare
DB_USER=postgres
DB_PASSWORD=test

# ===== API Backend FastAPI =====
API_URL=http://backend:8000
JWT_SECRET=change_moi_en_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ===== Modèle ML =====
MODEL_PATH=/app/ml/models/model.pkl
FRAUD_THRESHOLD=0.8

# ===== n8n =====
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_WEBHOOK_URL=http://n8n:5678/webhook/predicare-alerte

# ===== RAG / Ollama =====
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
CACHE_SEUIL=0.92
CACHE_TTL_HEURES=24

# ===== Streamlit =====
STREAMLIT_SERVER_PORT=8501